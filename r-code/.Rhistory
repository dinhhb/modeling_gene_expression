library(pheatmap)
batch_vec <- meta$batch          # factor: as.factor(meta$source)
# Annotation for heatmap columns (samples)
annot_df <- data.frame(Batch = batch_vec,
row.names = colnames(count_tbl_log))
# Colour palette per batch level
